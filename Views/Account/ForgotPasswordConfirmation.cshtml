@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password Confirmation - LogiDriver</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .confirmation-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 50px;
            text-align: center;
            width: 100%;
            max-width: 450px;
        }
        .confirmation-container h2 {
            color: #333;
            margin-bottom: 20px;
        }
        .confirmation-container p {
            color: #666;
            font-size: 16px;
        }
    </style>
</head>
<body>
    <div class="confirmation-container">
        <h2>Check your email</h2>
        <p>If an account with that email address exists, we have sent an email with a link to reset your password. Please check your inbox.</p>
    </div>
</body>
</html>
