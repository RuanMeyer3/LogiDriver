@model LogiDriverPortal.Models.Driver

@{
    ViewData["Title"] = "Add Driver";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title-main">Add Driver</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Back to Drivers
    </a>
</div>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <h4 class="mt-2">Driver Details</h4>
    <hr />
    <div class="form-group">
        <label asp-for="FullName" class="control-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DriverCode" class="control-label"></label>
        <input asp-for="DriverCode" class="form-control" />
        <span asp-validation-for="DriverCode" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Phone" class="control-label"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AssignedVehicle" class="control-label"></label>
        <input asp-for="AssignedVehicle" class="form-control" />
        <span asp-validation-for="AssignedVehicle" class="text-danger"></span>
    </div>

    <h4 class="mt-4">Login Credentials</h4>
    <hr />
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Password" class="control-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group mt-4">
        <input type="submit" value="Create Driver Account" class="btn btn-primary" />
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}