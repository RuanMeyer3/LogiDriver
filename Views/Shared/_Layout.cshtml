<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LogiDriver</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo-container">
                    <i class="fas fa-truck"></i>
                    <span class="logo-text">LogiDriver</span>
                </div>
                <button class="menu-toggle" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <ul class="sidebar-menu">
                <li class="menu-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <a asp-controller="Home" asp-action="Dashboard">
                        <i class="fas fa-chart-line"></i>
                        <span>Overview</span>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="#" onclick="alert('Route Planning - Coming Soon'); return false;">
                        <i class="fas fa-route"></i>
                        <span>Route Planning</span>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="#" onclick="alert('Live Tracking - Coming Soon'); return false;">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Live Tracking</span>
                    </a>
                </li>
                <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Driver" ? "active" : "")">
                    <a asp-controller="Driver" asp-action="Index">
                        <i class="fas fa-users"></i>
                        <span>Driver Management</span>
                    </a>
                </li>
                <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Fleet" ? "active" : "")">
                    <a asp-controller="Fleet" asp-action="Index">
                        <i class="fas fa-truck"></i>
                        <span>Fleet Management</span>
                    </a>
                </li>
                <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Alerts" ? "active" : "")">
                    <a asp-controller="Alerts" asp-action="Index">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>Alerts & Safety</span>
                    </a>
                </li>
                <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")">
                    <a asp-controller="Reports" asp-action="Index">
                        <i class="fas fa-file-alt"></i>
                        <span>Reports</span>
                    </a>
                </li>
                <li class="menu-item logout-item">
                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                        <button type="submit" class="logout-btn">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Navbar -->
            <nav class="top-navbar">
                <div class="navbar-content">
                    <h1 class="page-title">@ViewData["Title"]</h1>
                    <div class="navbar-right">
                        <button class="notification-btn">
                            <i class="fas fa-bell"></i>
                            <span class="badge">3</span>
                        </button>
                        <div class="user-profile">
                            <span class="user-initials">SV</span>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Page Content -->
            <div class="page-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>